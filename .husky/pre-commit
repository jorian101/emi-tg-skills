#!/usr/bin/env bash
# pre-commit — guard anti-PII de tg-skills.
#
# Bloquea el commit si las líneas AGREGADAS contienen datos privados: rutas personales,
# emails, identificadores de notebook o los apellidos reales que tengas en tu denylist local.
#
# Instalación (sin dependencias de node):
#     git config core.hooksPath .husky
#
# El denylist de apellidos reales NO vive en el repo (sería la fuga que intenta evitar):
# se lee de .pii-denylist.local, que está en .gitignore y es opcional.
set -uo pipefail

FAIL=0
reportar() { printf '  %s\n    %s\n' "$1" "$2"; FAIL=1; }

# --- Patrones genéricos (seguros de publicar: son regex, no datos) ---
check_genericos() {
  local archivo="$1" lineas="$2"

  local hit
  hit="$(printf '%s\n' "$lineas" | grep -nE '/home/[a-z0-9_.-]+/|/Users/[A-Za-z0-9_.-]+/|/mnt/[a-z]/|~/proyectos/' || true)"
  [ -n "$hit" ] && reportar "$archivo: ruta personal absoluta" "$hit"

  hit="$(printf '%s\n' "$lineas" | grep -nE '^\+.*[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\.[A-Za-z]{2,}' || true)"
  if [ -n "$hit" ]; then
    case "$archivo" in
      *@example.com*|*.example) : ;;
      *) reportar "$archivo: email" "$hit" ;;
    esac
  fi

  hit="$(printf '%s\n' "$lineas" | grep -nEi 'notebooklm\.google\.com|/notebook/[0-9a-f-]{36}|[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}' || true)"
  [ -n "$hit" ] && reportar "$archivo: identificador de notebook / UUID" "$hit"

  hit="$(printf '%s\n' "$lineas" | grep -nEi 'nvapi-|sk-[A-Za-z0-9]{20,}|ghp_[A-Za-z0-9]{20,}|api[_-]?key[[:space:]]*[:=][[:space:]]*["'"'"'][A-Za-z0-9]{16,}' || true)"
  [ -n "$hit" ] && reportar "$archivo: posible credencial" "$hit"
}

# --- Denylist local (apellidos y nombres reales) ---
DENY=".pii-denylist.local"
check_denylist() {
  local archivo="$1" lineas="$2"
  [ -f "$DENY" ] || return 0
  local hit
  # Sin -i a proposito: los apellidos van capitalizados, y "terceros" (palabra comun)
  # no debe confundirse con el apellido "Terceros".
  hit="$(printf '%s\n' "$lineas" | grep -nEf <(grep -vE '^[[:space:]]*(#|$)' "$DENY") || true)"
  [ -n "$hit" ] && reportar "$archivo: término del denylist local" "$hit"
}

# --- Recorrido de los archivos staged ---
while IFS= read -r f; do
  [ -n "$f" ] || continue
  # Patrones LITERALES: en un `case`, una variable no expande los `|` como alternativas.
  case "$f" in
    *.example|*.template|.pii-denylist.local|docs/ejemplos/*|.husky/*|scripts/auditar-pii.sh) continue ;;
  esac
  LINEAS="$(git diff --cached -U0 -- "$f" | grep -E '^\+' | grep -v '^+++' || true)"
  [ -n "$LINEAS" ] || continue
  check_genericos "$f" "$LINEAS"
  check_denylist "$f" "$LINEAS"
done < <(git diff --cached --name-only --diff-filter=ACM)

if [ "$FAIL" -ne 0 ]; then
  cat <<'AVISO'

Commit bloqueado por el guard anti-PII.

Qué hacer:
  - Si es un dato real: movelo a config.local.md / .env.local (ambos en .gitignore).
  - Si es un ejemplo: usá un placeholder y, si hace falta un caso completo, ponelo en
    docs/ejemplos/ (esa carpeta está exenta).
  - Si es una ruta de este repo: usá rutas relativas o variables.

Para saltearlo de forma deliberada y consciente: git commit --no-verify
AVISO
  exit 1
fi
