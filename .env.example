# Config privada de los scripts — NUNCA se commitea.
# Copiar a .env.local y completar. Los scripts lo cargan con `source .env.local`.
#
# El motor no hardcodea ninguna ruta: si falta una variable, el script falla
# explicando cuál, en vez de adivinar. Ver docs/arquitectura.md.

# --- Rutas del usuario ---

# Raíz del vault (datos: perfiles de evaluadores, reglas, informes, propuestas).
VAULT="$HOME/mi-vault"

# Carpeta con los documentos fuente del trabajo de grado (Word/PDF, anexos, respaldos).
CORPUS="$HOME/documentos/trabajo-de-grado"

# Carpeta con los informes de revisión a ingerir (una subcarpeta por docente).
INFORMES="$HOME/documentos/informes-revisores"

# Repositorio del sistema que documentás (solo si usás las skills de entregables).
CODE_REPO="$HOME/proyectos/mi-sistema"

# Dónde están instaladas las skills (normalmente el clon de este repo).
SKILLS="$HOME/tg-skills/skills"

# Binarios locales propios (nlm, etc.).
LOCAL_BIN="$HOME/.local/bin"

# --- Bibliografía (opcional) ---

# Archivo de Zotero, para el snapshot de solo lectura.
ZOTERO_DB="$HOME/Zotero/zotero.sqlite"

# Carpeta de adjuntos de Zotero (para resolver las rutas de los PDF).
ZOTERO_STORAGE="$HOME/Zotero/storage"

# --- NotebookLM (opcional: solo para el modo notebooklm) ---

# Id del notebook con el material de tus docentes. Dejarlo vacío si no lo usás.
NLM_NOTEBOOK_ID=""

# Alias con el que `nlm` referencia ese notebook.
NLM_ALIAS="docentes"
