# Config privada de los scripts — NUNCA se commitea.
# Copiar a .env.local y completar. Los scripts lo cargan con `source .env.local`.

# Raíz del vault (datos: perfiles, reglas, informes, propuestas).
VAULT="$HOME/proyectos/mi-vault"

# Carpeta donde están tus documentos fuente (Word/PDF del trabajo de grado).
CORPUS="$HOME/documentos/trabajo-de-grado"

# Base de datos de Zotero, para el snapshot bibliográfico de solo lectura.
ZOTERO_SQLITE="$HOME/Zotero/zotero.sqlite"

# NotebookLM: id del notebook con el material de tus docentes.
# Dejarlo vacío si no usás el modo notebooklm.
NLM_NOTEBOOK_ID=""

# Alias con el que `nlm` referencia ese notebook.
NLM_ALIAS="docentes"
